{
  "name": "boltline-autoresearch",
  "version": "0.1.0",
  "description": "Autonomous experiment runner for Boltline marketing content optimization",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "experiment": "tsx src/cli/experiment.ts",
    "experiment:local": "tsx --env-file=.env src/cli/experiment.ts",
    "cli": "tsx --env-file=.env src/cli/index.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@supabase/supabase-js": "^2.98.0",
    "commander": "^14.0.3",
    "hono": "^4.12.5"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.3.5",
    "js-yaml": "^4.1.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
